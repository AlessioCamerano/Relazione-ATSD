((=- Default to the notebook output style -=))
((*- if not cell_style is defined -*))
    ((* set cell_style = 'style_jupyter.tex.j2' *))
((*- endif -*))

((=- Inherit from the specified cell style. -=))
((* extends cell_style *))


%===============================================================================
% Document class
%===============================================================================
((* block docclass *))
\documentclass[11pt,a4paper]{article}
((* endblock docclass *))

%===============================================================================
% Packages
%===============================================================================
((* block packages *))
((( super() )))
\usepackage{geometry}
\usepackage{titling}
\geometry{a4paper, top=3cm, bottom=3cm, left=2.5cm, right=2.5cm}
((* endblock packages *))

%===============================================================================
% Title and Author
%===============================================================================
((* block title *))
\title{((( nb.metadata.get('title', 'Analisi dei Segnali del Giroscopio') | escape_latex )))}
\author{Studente: ((( nb.metadata.get('author', 'Alessio Camerano') | escape_latex ))) \\
Matricola: ((( nb.metadata.get('matricola', '1044444') | escape_latex ))) \\
Corso: ((( nb.metadata.get('course', 'Analisi e Trattamento Segnali Digitali') | escape_latex )))}
\date{\today}
((* endblock title *))

%===============================================================================
% Maketitle and TOC
%===============================================================================
((* block predoc *))
((( super() )))
\maketitle
\thispagestyle{empty}
\newpage
\tableofcontents
\newpage
((* endblock predoc *))

%===============================================================================
% Hide input and output prompts
%===============================================================================
((* block in_prompt *))
((* endblock in_prompt *))

((* block out_prompt *))
((* endblock out_prompt *))
